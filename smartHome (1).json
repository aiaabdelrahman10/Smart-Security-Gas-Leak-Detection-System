    {
        "id": "3c50f53752bcb532",
        "type": "function",
        "z": "79cac5052ad922de",
        "name": "function 1",
        "func": "switch (msg.payload) {\n\n    case \"SAFE\":\n        msg.payload = `\n        <div style=\"\n        background:#4CAF50;\n        color:white;\n        padding:20px;\n        border-radius:12px;\n        text-align:center;\n        font-size:30px;\n        font-weight:bold;\">\n        🟢 SAFE\n        <br>\n        <span style=\"font-size:18px;\">\n        Air Quality Normal\n        </span>\n        </div>`;\n        break;\n\n    case \"GAS LEAK DETECTED\":\n        msg.payload = `\n        <div style=\"\n        background:#F44336;\n        color:white;\n        padding:20px;\n        border-radius:12px;\n        text-align:center;\n        font-size:30px;\n        font-weight:bold;\">\n        🔴 GAS LEAK DETECTED\n        <br>\n        <span style=\"font-size:18px;\">\n        Evacuate Immediately\n        </span>\n        </div>`;\n        break;\n\n    case \"ALARM DISABLED\":\n        msg.payload = `\n        <div style=\"\n        background:#757575;\n        color:white;\n        padding:20px;\n        border-radius:12px;\n        text-align:center;\n        font-size:30px;\n        font-weight:bold;\">\n        ⚪ ALARM DISABLED\n        <br>\n        <span style=\"font-size:18px;\">\n        Monitoring Paused\n        </span>\n        </div>`;\n        break;\n\n    default:\n        msg.payload = `\n        <div style=\"\n        background:#2196F3;\n        color:white;\n        padding:20px;\n        border-radius:12px;\n        text-align:center;\n        font-size:28px;\">\n        Unknown Status\n        </div>`;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 360,
        "wires": [
            [
                "9d42fb152915d1f2"
            ]
        ]
